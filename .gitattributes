# Legacy sources and scripts keep the line endings they were committed with.
# Tooling files must use a fixed line ending to work on every platform.
makefile	text eol=lf
*.sh		text eol=lf
*.yml		text eol=lf
*.md		text eol=lf
*.json		text eol=lf
*.sln		text eol=crlf
*.vcxproj	text eol=crlf
*.filters	text eol=crlf
