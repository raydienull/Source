# https://editorconfig.org
root = true

[*]
charset = utf-8
insert_final_newline = true

# Sources keep the line endings they were committed with
[*.{c,cpp,h,tbl}]
indent_style = tab
tab_width = 4

[{Makefile,*.mk}]
indent_style = tab
end_of_line = lf

[*.{md,yml,json,sh}]
indent_style = space
indent_size = 2
end_of_line = lf
trim_trailing_whitespace = true

[*.sh]
indent_style = tab

[*.{vcxproj,filters,sln}]
end_of_line = crlf
