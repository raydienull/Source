    <PreBuildEvent>
      <Message>Generating version header</Message>
      <Command>set "VERSION_FILE=$(MSBuildProjectDirectory)\src\common\version.h"
set "GIT_COUNT=0"
set "GIT_HASH=unknown"
for /f %%i in ('git rev-list --count HEAD 2^&gt;nul') do set "GIT_COUNT=%%i"
for /f %%i in ('git rev-parse --short HEAD 2^&gt;nul') do set "GIT_HASH=%%i"
&gt; "%VERSION_FILE%" echo // Auto-generated by the build system. Do not edit.
&gt;&gt; "%VERSION_FILE%" echo #define SPHERE_BUILD_NUMBER %GIT_COUNT%
&gt;&gt; "%VERSION_FILE%" echo #define SPHERE_GIT_HASH "%GIT_HASH%"
echo Build number: %GIT_COUNT% (git %GIT_HASH%)</Command>
    </PreBuildEvent>
  </ItemDefinitionGroup>
